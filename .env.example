# Copia este archivo a .env.local para desarrollo. NUNCA subas .env.local al repositorio.

# Modo de autenticación: "supabase" (producción) o "local" (solo desarrollo / Codespaces).
VITE_AUTH_MODE=local

# Solo modo local (desarrollo): contraseña inicial del administrador "admin".
# En Codespaces se toma automáticamente del secreto ADMIN_INITIAL_PASSWORD.
VITE_LOCAL_ADMIN_PASSWORD=

# Modo supabase: valores públicos del proyecto (la "anon/publishable key" es pública por diseño;
# la seguridad la aplican las políticas RLS y la Edge Function).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dominio interno usado para mapear nombres de usuario a correos de Supabase (no se envían correos).
VITE_USERNAME_EMAIL_DOMAIN=usuarios.aprender-ingles.app
